# -*- mode: conf -*-
#
# CLHEP "HEP System of Units", translated into the dune-units source-of-truth
# format.  This is a faithful, line-by-line transcription of
#
#     CLHEP/Units/SystemOfUnits.h
#     https://github.com/Geant4/geant4/blob/master/source/externals/clhep/include/CLHEP/Units/SystemOfUnits.h
#
# The base units of the system are:
#
#     millimeter              (length)
#     nanosecond              (time)
#     megaelectronvolt        (energy)
#     eplus                   (positron charge)
#     kelvin                  (temperature)
#     mole                    (amount of substance)
#     radian                  (angle)
#     candela                 (luminous intensity)
#
# INTENT: this file is a mirror of CLHEP and is NOT meant to be edited.  Put new
# or non-CLHEP units, and any constants of nature, in dune.units instead.
#
# Format (see ../README.md):
#   - blank lines and lines starting with '#' are ignored
#   - "@section <text>"   sets a grouping label for the definitions that follow
#   - "@kind unit|constant" tags the following definitions (default: unit)
#   - "NAME = EXPRESSION"  defines a symbol; EXPRESSION is arithmetic ( + - * /
#     ** and parentheses ) over numeric literals and previously defined names.

@kind unit

@section Mathematical constants
pi     = 3.14159265358979323846
twopi  = 2*pi
halfpi = pi/2
pi2    = pi*pi

@section Length [L]
millimeter  = 1.
millimeter2 = millimeter*millimeter
millimeter3 = millimeter*millimeter*millimeter
centimeter  = 10.*millimeter
centimeter2 = centimeter*centimeter
centimeter3 = centimeter*centimeter*centimeter
meter  = 1000.*millimeter
meter2 = meter*meter
meter3 = meter*meter*meter
kilometer = 1000.*meter
kilometer2 = kilometer*kilometer
kilometer3 = kilometer*kilometer*kilometer
parsec = 3.0856775807e+16*meter
micrometer = 1.e-6 *meter
nanometer = 1.e-9 *meter
angstrom  = 1.e-10*meter
fermi     = 1.e-15*meter
barn = 1.e-28*meter2
millibarn = 1.e-3 *barn
microbarn = 1.e-6 *barn
nanobarn = 1.e-9 *barn
picobarn = 1.e-12*barn
nm  = nanometer
um  = micrometer
mm  = millimeter
mm2 = millimeter2
mm3 = millimeter3
cm  = centimeter
cm2 = centimeter2
cm3 = centimeter3
liter = 1.e+3*cm3
L = liter
dL = 1.e-1*liter
cL = 1.e-2*liter
mL = 1.e-3*liter
m  = meter
m2 = meter2
m3 = meter3
km  = kilometer
km2 = kilometer2
km3 = kilometer3
pc = parsec

@section Angle
radian      = 1.
milliradian = 1.e-3*radian
degree = (pi/180.0)*radian
steradian = 1.
rad  = radian
mrad = milliradian
sr   = steradian
deg  = degree

@section Time [T]
nanosecond  = 1.
second      = 1.e+9 *nanosecond
millisecond = 1.e-3 *second
microsecond = 1.e-6 *second
picosecond  = 1.e-12*second
minute = 60*second
hour   = 60*minute
day    = 24*hour
year   = 365*day
hertz = 1./second
kilohertz = 1.e+3*hertz
megahertz = 1.e+6*hertz
ns = nanosecond
s = second
ms = millisecond
us = microsecond
ps = picosecond

@section Electric charge [Q]
eplus = 1.
e_SI  = 1.602176634e-19
coulomb = eplus/e_SI

@section Energy [E]
megaelectronvolt = 1.
electronvolt     = 1.e-6*megaelectronvolt
kiloelectronvolt = 1.e-3*megaelectronvolt
gigaelectronvolt = 1.e+3*megaelectronvolt
teraelectronvolt = 1.e+6*megaelectronvolt
petaelectronvolt = 1.e+9*megaelectronvolt
millielectronvolt = 1.e-9*megaelectronvolt
joule = electronvolt/e_SI
MeV = megaelectronvolt
eV = electronvolt
keV = kiloelectronvolt
GeV = gigaelectronvolt
TeV = teraelectronvolt
PeV = petaelectronvolt

@section Mass [E][T^2][L^-2]
kilogram = joule*second*second/(meter*meter)
gram = 1.e-3*kilogram
milligram = 1.e-3*gram
kg = kilogram
g = gram
mg = milligram

@section Power [E][T^-1]
watt = joule/second

@section Force [E][L^-1]
newton = joule/meter

@section Pressure [E][L^-3]
hep_pascal = newton/m2
# CLHEP exposes hep_pascal also as "pascal" (the plain name is #define'd because
# some platforms reserve it as a macro); bar and atmosphere reference it.
pascal     = hep_pascal
bar        = 100000*pascal
atmosphere = 101325*pascal

@section Electric current [Q][T^-1]
ampere = coulomb/second
milliampere = 1.e-3*ampere
microampere = 1.e-6*ampere
nanoampere = 1.e-9*ampere

@section Electric potential [E][Q^-1]
megavolt = megaelectronvolt/eplus
kilovolt = 1.e-3*megavolt
volt     = 1.e-6*megavolt

@section Electric resistance [E][T][Q^-2]
ohm = volt/ampere

@section Electric capacitance [Q^2][E^-1]
farad = coulomb/volt
millifarad = 1.e-3*farad
microfarad = 1.e-6*farad
nanofarad = 1.e-9*farad
picofarad = 1.e-12*farad

@section Magnetic Flux [T][E][Q^-1]
weber = volt*second

@section Magnetic Field [T][E][Q^-1][L^-2]
tesla     = volt*second/meter2
gauss     = 1.e-4*tesla
kilogauss = 1.e-1*tesla

@section Inductance [T^2][E][Q^-2]
henry = weber/ampere

@section Temperature
kelvin = 1.

@section Amount of substance
mole = 1.

@section Activity [T^-1]
becquerel = 1./second
curie = 3.7e+10 * becquerel
kilobecquerel = 1.e+3*becquerel
megabecquerel = 1.e+6*becquerel
gigabecquerel = 1.e+9*becquerel
millicurie = 1.e-3*curie
microcurie = 1.e-6*curie
Bq = becquerel
kBq = kilobecquerel
MBq = megabecquerel
GBq = gigabecquerel
Ci = curie
mCi = millicurie
uCi = microcurie

@section Absorbed dose [L^2][T^-2]
gray = joule/kilogram
kilogray = 1.e+3*gray
milligray = 1.e-3*gray
microgray = 1.e-6*gray

@section Luminous intensity [I]
candela = 1.

@section Luminous flux [I]
lumen = candela*steradian

@section Illuminance [I][L^-2]
lux = lumen/meter2

@section Miscellaneous
perCent     = 0.01
perThousand = 0.001
perMillion  = 0.000001
